# Optional. Public Qwen models do not require a Hugging Face token.
HF_TOKEN=

# Model downloaded on first run.
# Previous, larger default: Qwen/Qwen2.5-3B-Instruct
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct

PORT=3000

# Listen on this machine only. Set HOST=0.0.0.0 if another device must reach it.
HOST=127.0.0.1

# Set to 1 to enable the Flask reloader. Leave unset for normal use.
# FLASK_DEBUG=0

# Used only by compare_models.py. The web app does not call Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
